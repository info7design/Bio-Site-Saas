# Postgres — em produção deve apontar para uma instância/serviço isolado
# do outro projeto (SaaS de WhatsApp) rodando na mesma VPS.
DATABASE_URL="postgresql://biosite:biosite@localhost:5432/biosite?schema=public"

# Segredo usado para assinar/validar tokens de sessão (gerar com: openssl rand -hex 32)
SESSION_SECRET="troque-este-valor-por-um-segredo-aleatorio-forte"

# Domínio público do app (usado para links absolutos, QR Code, cookies)
NEXT_PUBLIC_APP_URL="https://linkbio.manifesti.com.br"

NODE_ENV="development"
